# Plantilla de config de DEPLOY del controller en la Pi (Ros2Strategy).
# Copiar a `.env` en la Pi y ajustar SERVER_URL. `.env` está gitignoreado.
#
# El resto de la config de deploy (LOCAL_STRATEGY, REMOTE_STRATEGY, MOCK_ROBOT,
# CREATE_DEFAULT_METADATA, METADATA_FILE, ROS2_*) viene horneada como ENV default
# en la imagen (stage `final` del Dockerfile) — no hace falta repetirla acá.
# env_file/-e en runtime siempre gana sobre el ENV horneado, así que se puede
# overridear cualquier default puntual agregándolo a este archivo.
SERVER_URL='http://CAMBIAME-API-HOST:8000/m2m/robot/'
# Requerido por config.py aunque Ros2Strategy no use serial (bug conocido, fuera
# de alcance por ahora). No se hornea en la imagen a propósito.
ARDUINO_PORT='/dev/null'
