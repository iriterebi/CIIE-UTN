SERVER_URL='http://localhost:8000/m2m/robot/'
ARDUINO_PORT='/dev/serial/by-id/usb-Arduino__www.arduino.cc__0043_85133323136351B070E0-if00'
CREATE_DEFAULT_METADATA=1
MOCK_ROBOT=1
METADATA_FILE='./robot-metadata.json'

# Strategy local a usar al arrancar: MockStrategy | Ros2Strategy
# LOCAL_STRATEGY='MockStrategy'

# Ros2Strategy (solo aplica con LOCAL_STRATEGY='Ros2Strategy'; requiere ROS 2 sourceado).
# rclpy NO se instala vía uv: viene del entorno ROS 2 de la Pi.
ROS2_NODE_NAME='labs_remoto_robot'
ROS2_COMMAND_TOPIC='/inorbit/custom_command'
ROS2_DATA_TOPIC='/inorbit/custom_data'
# Debe coincidir con el ROS_DOMAIN_ID del agente ROS de la Pi (el scraper corre en 42).
ROS2_DOMAIN_ID=42

# CameraRelay (video de la cámara USB vía ROS 2 → WS dedicado a la Api; ver
# docs/superpowers/specs/2026-08-20-camera-video-webclient-design.md).
# Independiente de LOCAL_STRATEGY: si no hay entorno ROS 2/opencv, no arranca
# y el resto del controller sigue funcionando.
CAMERA_NODE_NAME='labs_remoto_camera'
CAMERA_TOPIC='usb_cam/image_raw'
CAMERA_JPEG_QUALITY=80
