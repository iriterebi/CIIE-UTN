[Unit]
Description=RosBridge — Puente WebSocket/JSON entre API y ROS 2
After=network-online.target

[Container]
Image=localhost/labs-remoto/rosbridge
ContainerName=rosbridge

# Red interna — accesible por otros contenedores como "rosbridge"
Network=labs-remoto.network
NetworkAlias=rosbridge

# Puerto expuesto en localhost (para RaspberryPis en la intranet via proxy)
PublishPort=127.0.0.1:9090:9090

# ROS 2 domain ID
Environment=ROS_DOMAIN_ID=0

# Comando de arranque
Exec=ros2 launch /ros_bridge_ws/launch/bridge.launch.py

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target default.target
